# Leave empty for persistent local PostgreSQL via PGlite. Required on Vercel.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
# Generate a random secret of at least 32 characters for cron authentication.
CRON_SECRET=
# Use a trusted reverse proxy before enabling IP-based registration limits.
TRUST_PROXY=false

# Optional Sepolia victory receipts. Leave empty until the custom contract is deployed/verified.
SEPOLIA_RPC_URL=
WIN_REGISTRY_ADDRESS=
WIN_REGISTRY_CODE_HASH=
WIN_ATTESTOR_ADDRESS=
# Authenticated isolated attestation service; HTTPS required outside loopback.
WIN_SIGNER_URL=
WIN_SIGNER_TOKEN=
# Do NOT put a wallet private key in this application's environment.
# The isolated operator signer has its own ignored .env.signer.local; see docs/ONCHAIN_WINS.md.
